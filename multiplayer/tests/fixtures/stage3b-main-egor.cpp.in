using namespace hyprwalk;
struct wl_event_source{int fd;int(*fn)(int,uint32_t,void*);void* data;bool removed=false;};
struct wl_event_loop{std::vector<std::unique_ptr<wl_event_source>> sources;bool reject=false;} loop;
constexpr uint32_t WL_EVENT_READABLE=1,WL_EVENT_HANGUP=4,WL_EVENT_ERROR=8;
wl_event_source* wl_event_loop_add_fd(wl_event_loop* l,int fd,uint32_t,int(*fn)(int,uint32_t,void*),void* data){
 if(l->reject)return nullptr;l->sources.push_back(std::make_unique<wl_event_source>(wl_event_source{fd,fn,data}));return l->sources.back().get();}
int wl_event_source_remove(wl_event_source* s){s->removed=true;return 0;}
struct Compositor{wl_event_loop* m_wlEventLoop=&loop;}compositor;auto* g_pCompositor=&compositor;
namespace hyprwalk{void log(const std::string&) {}}
void require(bool b,const std::source_location l=std::source_location::current()){if(!b)throw std::runtime_error("integration test failed at line "+std::to_string(l.line()));}
void pump(){std::vector<wl_event_source*> snapshot;for(auto& p:loop.sources)snapshot.push_back(p.get());for(auto* s:snapshot){if(s->removed)continue;pollfd fd{s->fd,POLLIN,0};if(::poll(&fd,1,1)>0)s->fn(s->fd,WL_EVENT_READABLE,s->data);}}
void wait(const std::function<bool()>& f){const auto end=std::chrono::steady_clock::now()+std::chrono::seconds(4);while(!f()){require(std::chrono::steady_clock::now()<end);pump();}}
struct Vector2D{double x=1280,y=960;};
struct Monitor{Vector2D m_size;};
namespace hypr{void scheduleFrame(const std::shared_ptr<Monitor>&) {}}
struct Screen{Vector2D logicalSize;SDesktopAnchor anchor;void setAnchor(const SDesktopAnchor& a){anchor=a;}};
constexpr int MODE_OFF=0,MODE_ACTIVE=2;
#ifdef HYPRWALK_MULTIPLAYER
class EgorAdapter final : public hyprwalk::mp::IAdapter {
  public:
    hyprwalk::mp::PlayerSync remote;
    std::optional<hyprwalk::mp::MapDescriptor> map;
    std::optional<hyprwalk::mp::WorldRequest> pendingWorld;
    std::optional<hyprwalk::mp::MapDescriptor> localMap() const override { return map; }
    void onWorldRequest(const hyprwalk::mp::WorldRequest& request) noexcept override { pendingWorld = request; }
    bool udpReady = false;
    hyprwalk::mp::Id session{}, peer{};
    void onPlayerSnapshot(const hyprwalk::mp::ReceivedPlayer& value) noexcept override {
        if (udpReady)
            remote.push(value);
    }
    hyprwalk::mp::LocalInfo localInfo() const override { return {"egor"}; }
    void onState(const hyprwalk::mp::Status& state) noexcept override {
        udpReady = state.state == hyprwalk::mp::State::Connected && state.udp.state == hyprwalk::mp::UdpState::Ready &&
                   state.world == hyprwalk::mp::WorldState::Ready;
        if (!udpReady || session != state.session || peer != state.peerId)
            remote.reset();
        if (state.world == hyprwalk::mp::WorldState::Disabled || state.world == hyprwalk::mp::WorldState::Rejected)
            pendingWorld.reset();
        session = state.session;
        peer = state.peerId;
        try { hyprwalk::log("multiplayer: " + hyprwalk::mp::formatStatus(state)); } catch (...) {}
    }
    void onDiagnostic(const hyprwalk::mp::Diagnostic& event) noexcept override {
        try { hyprwalk::log("multiplayer: " + event.text); } catch (...) {}
    }
};
#endif

constexpr uint32_t K_TAB=15,HL_MODIFIER_SHIFT=1,HL_MODIFIER_CTRL=4,HL_MODIFIER_ALT=8;

namespace hyprwalk {
    struct SAvatarFrame {
        std::shared_ptr<SAvatarModel> model;            // null = none
        const std::vector<float>*     joints = nullptr; // CAvatarAnimator::joints()
        const std::vector<float>*     morphs = nullptr; // CAvatarAnimator::morphWeights(), null = at rest
        const std::vector<SMapMaterial>* materials = nullptr; // CAvatarAnimator::materials(), null = the model's
        const std::vector<uint8_t>*   shown = nullptr;  // CAvatarAnimator::partsShown(), null = all of it
        const std::vector<int>*       batchMaterials = nullptr; // CAvatarAnimator::batchMaterials(), null = own
        M4                            transform = M4::identity(); // avatar space -> world
        bool                          visible = false;  // drawn (third person); casts a shadow either way
        bool                          firstPerson = false; // camera in its eyes; the head isn't drawn
        bool                          outlines = true;  // toon outlines (inverted hulls)
        float                         sky = 1, bounce = 0; // light around it, like the map's baked values

        bool                          drawn(const SAvatarBatch& b) const {
            return !shown || (size_t)b.part >= shown->size() || (*shown)[b.part];
        }
        // visible index range (first, count): in first person without the head; the shadow uses all
        std::pair<uint32_t, uint32_t> range(const SAvatarBatch& b) const {
            return !firstPerson || b.fpCount == UINT32_MAX || !b.count ? std::pair{b.first, b.count} : std::pair{b.fpFirst, b.fpCount};
        }
        int                           material(const SAvatarBatch& b, size_t i) const { // what batch i is drawn with
            return batchMaterials && i < batchMaterials->size() ? (*batchMaterials)[i] : b.material;
        }
    };
struct SFrameParams{SAvatarFrame avatar,remoteAvatar;SRemotePlayerFrame remotePlayer;};
namespace gl {struct CStateGuard {};}
}
struct BoolConfig{bool value()const{return true;}};BoolConfig* g_cfgAvatarPhysics=nullptr;
namespace Render::GL {struct Context{void makeEGLCurrent(){}} context;Context* g_pHyprOpenGL=&context;}
struct RendererDouble{int clears=0;void clearRemoteAvatar(){++clears;}bool remoteAvatarFailed(const std::shared_ptr<SAvatarModel>&)const{return false;}bool remoteAvatarReady(const std::shared_ptr<SAvatarModel>&)const{return false;}};

class CDesktop3D{public:
 std::shared_ptr<SAvatarModel> m_avatar;float m_avatarHeight=1.75f;RendererDouble m_renderer;
    std::unique_ptr<CRemoteAvatar>   m_remoteAvatar;
    wl_event_source*                 m_remoteAvatarSource = nullptr;
    hyprwalk::mp::Id                 m_remoteAvatarPeer{}, m_remoteAvatarSession{};
    std::string                     m_remoteAvatarSelection = "default", m_remoteAvatarError, m_remoteAvatarBlocked;
    uint64_t                        m_remoteAvatarRevision = 1;
    bool                            m_remoteAvatarSuspended = false;
    void                            multiplayerAvatarUpdate();
    void                            multiplayerAvatarFrame(SFrameParams& frame);
    void                            clearMultiplayerAvatarGpu();
    void                            shutdownMultiplayerAvatar();
    std::string                     multiplayerAvatarCommand(const std::vector<std::string>& args);



    std::array<bool,256> m_keys{}; std::set<uint32_t> m_consumed; bool m_jumpWasDown=false;
    mp::OnlineMenu m_online;
    SMenuPage onlinePage(const std::string&);
    std::string onlineAction(const SMenuItem&);
    CActionMenu m_menu{[this](const std::string& id){return id=="main"?actionPage(id,{}):onlinePage(id);}};
    uint32_t customBinding=15;
    uint32_t binding(const std::string&) {return customBinding;}
    std::string notified;
    void notify(const std::string& s,bool) {notified=s;}
    std::string menuAction(const SMenuItem& it) {return it.action==MA_ONLINE?onlineAction(it):"unhandled fixture action";}
    void menuPick(const std::optional<SMenuItem>& item);
    struct Callback{bool cancelled=false;};
    void press(uint32_t k,uint32_t mods,Callback& info);
    void release(uint32_t k,Callback& info);
    void key(uint32_t k,uint32_t mods=0){
        Callback event; press(k,mods,event);require(event.cancelled);
        Callback releaseEvent;release(k,releaseEvent);require(releaseEvent.cancelled);require(!m_consumed.contains(k));
        m_menu.update(.1f,1920,1080,1.f);
    }
    void enterOnline(){m_menu.show("online");m_menu.update(.1f,1920,1080,1.f);}
    void editPort(const std::string& s){key(4);require(m_menu.onlineModal());for(char c:s)key(c=='0'?11:static_cast<uint32_t>(c-'0'+1));key(28);require(!m_menu.onlineModal());}

 int m_mode=MODE_ACTIVE;bool m_away=false,m_crouched=false,m_running=false,m_fly=false,m_rendererDirty=false;
 float m_yaw=0,m_pitch=0,m_bodyYaw=0,m_mapScale=0;
 struct Body{V3 feet,vel;bool onGround=true;}m_body;
 struct Loader{bool loading=false;bool busy()const{return loading;}}m_mapLoader;
 std::shared_ptr<Monitor> owner=std::make_shared<Monitor>();std::weak_ptr<Monitor> m_monitor=owner;
 SWorld m_world;Vector2D m_worldFor;Screen m_screen;
 void dropPlacements(){}void requestFrame(){}
 void resetPlayer(){m_body.feet=m_world.spawn;m_body.vel={};m_yaw=m_world.spawnYaw;
#ifdef HYPRWALK_MULTIPLAYER
 ++m_multiplayerTeleport;
#endif
 }
 std::string hyprctl(const std::string&);
 CDesktop3D(float aspect=16.f/9){SScreenSpec s;s.aspect=aspect;m_world=buildWorld(s);
#ifdef HYPRWALK_MULTIPLAYER
 m_multiplayerBuiltSpec=s;
#endif
 }
 ~CDesktop3D(){
#ifdef HYPRWALK_MULTIPLAYER
 shutdownMultiplayer();
#endif
 }
#ifdef HYPRWALK_MULTIPLAYER
    EgorAdapter                         m_multiplayerAdapter;
    std::unique_ptr<hyprwalk::mp::Multiplayer> m_multiplayer;
    wl_event_source*                 m_multiplayerSource = nullptr;
    std::string                     multiplayerCommand(const std::vector<std::string>& args);
    void                            multiplayerEvents();
    void                            multiplayerUpdate();
    uint32_t                        m_multiplayerTeleport = 0;
    SScreenSpec                     m_multiplayerBuiltSpec{}, m_multiplayerSavedSpec{};
    std::optional<SScreenSpec>       m_multiplayerSessionSpec;
    bool                            m_multiplayerMapApplied = false;
    std::optional<hyprwalk::mp::MapDescriptor> m_multiplayerWorldDescriptor;
    SDesktopAnchor                  m_multiplayerSavedDesktop;
    V3                              m_multiplayerSavedSpawn;
    float                           m_multiplayerSavedYaw = 0;
    bool                            multiplayerMapLocked() const;
